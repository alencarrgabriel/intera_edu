FROM ghcr.io/cirruslabs/flutter:3.38.10@sha256:3a94866984c440444661873d06668b0c38817923b931780e7932370618c484ed AS builder
WORKDIR /app
COPY . .
ARG API_BASE_URL=http://localhost:3000/api/v1
ARG WS_BASE_URL=http://localhost:3004
RUN flutter pub get --enforce-lockfile
RUN flutter build web --release --dart-define=API_BASE_URL=${API_BASE_URL} --dart-define=WS_BASE_URL=${WS_BASE_URL}

FROM nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build/web /usr/share/nginx/html
